SECRET_KEY=replace-with-a-local-development-secret
AUTH_REQUIRED=true
AUTH_LOCAL_USER_ID=ani.mallya
AUTH_SESSION_TTL_HOURS=168
# True only once an HTTPS origin actually exists, and false until then. Setting
# it true over plain HTTP leaves no working login anywhere: the browser refuses
# the cookie and there is no HTTPS origin to set it on. Serving through the
# named tunnel below makes it true; a quick tunnel does too, but its hostname
# changes on every restart.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ANIOS_GATEWAY_PORT=8080
AUTH_LOGIN_MAX_FAILURES=8
AUTH_LOGIN_FAILURE_WINDOW_SECONDS=900
AUTH_LOGIN_GLOBAL_MAX_ATTEMPTS=120
AUTH_LOGIN_GLOBAL_WINDOW_SECONDS=60
DEBUG=false

# Encryption at rest (off by default). Leave empty to store content as plaintext.
# Set a urlsafe-base64 AES-256 key to seal conversation, memory, and image
# content before it reaches disk: python -m backend.cli.generate_encryption_key
# Keep the key off the volume holding the backups it protects; if it is lost,
# already-sealed content cannot be recovered.
# Seals free-text columns at rest — interests, localities, subscriber
# addresses, remembered titles. Empty leaves them as plaintext in the database
# and in any backup taken of it. Generate one with:
#   python -m backend.cli.generate_encryption_key
# Turning it on later is safe: existing plaintext keeps reading and new writes
# are sealed. Turning it back off once sealed data exists raises rather than
# handing back ciphertext, so keep the key with your backups.
ENCRYPTION_KEY=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=anios_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_USE_NULL_POOL=false

LLM_BASE_URL=http://127.0.0.1:8003
LLM_MODEL=qwen/qwen3.5-4b
LLM_TIMEOUT_SECONDS=120
LLM_REASONING_EFFORT=none
INFERENCE_ADAPTER=openai_compatible
INFERENCE_PROVIDER_NAME=vllm
# These defaults passed the AniOS qualification suite on the documented RTX
# 5080 host. Re-run the suite before changing a production role assignment.
MAIN_LLM_MODEL=qwen/qwen3.5-4b
MAIN_INFERENCE_ADAPTER=
MAIN_LLM_BASE_URL=
MAIN_LLM_REASONING_EFFORT=none
PRESENTATION_LLM_MODEL=qwen/qwen3.5-4b
PRESENTATION_INFERENCE_ADAPTER=
PRESENTATION_LLM_BASE_URL=
PRESENTATION_LLM_REASONING_EFFORT=none
DIAGRAM_LLM_MODEL=qwen/qwen3.5-4b
DIAGRAM_INFERENCE_ADAPTER=
DIAGRAM_LLM_BASE_URL=
DIAGRAM_LLM_REASONING_EFFORT=none
MEMORY_PROPOSAL_INFERENCE_ADAPTER=
MEMORY_PROPOSAL_LLM_BASE_URL=
MEMORY_PROPOSAL_LLM_MODEL=qwen/qwen3.5-4b
MEMORY_PROPOSAL_LLM_REASONING_EFFORT=none
MEMORY_PROPOSAL_MAX_TOKENS=256
EMBEDDING_INFERENCE_ADAPTER=
EMBEDDING_BASE_URL=http://127.0.0.1:8004
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
EMBEDDING_MODEL_VERSION=nomic-embed-text-v1.5
EMBEDDING_DIMENSION=768
EMBEDDING_MAX_CONCURRENCY=1
MEMORY_SEMANTIC_MAX_COSINE_DISTANCE=0.35
MEMORY_SEMANTIC_MAX_RESULTS=5
MEMORY_SEMANTIC_MAX_CONTENT_CHARS=4000
CONVERSATION_HISTORY_TURNS=10
CONVERSATION_SUMMARY_INTERVAL=10

IMAGE_PROVIDER_BASE_URL=http://127.0.0.1:8188
IMAGE_PROVIDER_NAME=comfyui
# One FLUX.2 Klein checkpoint now serves both generation and editing, so the
# model, text encoder and VAE are shared rather than configured per role.
IMAGE_MODEL=flux-2-klein-9b-fp8.safetensors
IMAGE_TEXT_ENCODER=qwen_3_8b_fp8mixed.safetensors
IMAGE_VAE=flux2-vae.safetensors
# The distilled model is a four-step sampler in both directions.
IMAGE_GENERATION_STEPS=4
IMAGE_EDIT_STEPS=4
# How much of a source image survives into an edit, and how it is
# resampled to get there. The output is generated at this size, so this
# is the resolution ceiling of every edit: at 1.0 a phone photo came back
# as 1024x1024. Measured at 2.0 on a 16GB card with vLLM resident —
# 1440x1440 in 39 seconds, no memory error. `lanczos` rather than
# ComfyUI's `nearest-exact` default, which stipples skin and hair.
IMAGE_EDIT_MEGAPIXELS=1.0
IMAGE_EDIT_SCALE_METHOD=lanczos
# Appended to every generation prompt to steer toward realistic photos (the
# model runs at cfg=1.0, where a negative prompt has no effect). Realism comes
# from imperfection, not from asking for quality: terms like "sharp focus,
# high detail, 4k, professional photography" produce the glossy retouched look
# people read as AI. Leave empty to send prompts verbatim.
IMAGE_STYLE_SUFFIX=candid snapshot, shot on 35mm film, Kodak Portra 400, 50mm lens, available light only, uneven mixed lighting, visible film grain, natural unretouched skin with pores and fine lines, flyaway hair, slightly off-centre imperfect framing, mild motion blur, everyday unstyled scene
IMAGE_PROVIDER_TIMEOUT_SECONDS=600
IMAGE_PROVIDER_POLL_SECONDS=0.5
IMAGE_MAX_CONCURRENCY=1
ARTIFACT_STORAGE_ROOT=data/artifacts
PRESENTATION_RENDERER_BASE_URL=http://127.0.0.1:8002
PRESENTATION_RENDERER_TIMEOUT_SECONDS=60
PRESENTATION_MAX_OUTPUT_BYTES=52428800
PRESENTATION_MAX_TOKENS=8192
PRESENTATION_PLAN_MAX_TOKENS=2048
PRESENTATION_REVISION_MAX_TOKENS=1024
PRESENTATION_REQUIRE_OFFICE_VALIDATION=false
PRESENTATION_JOB_POLL_SECONDS=0.5
PRESENTATION_JOB_LEASE_SECONDS=300
PRESENTATION_JOB_HEARTBEAT_SECONDS=30
PRESENTATION_AUTO_IMAGE_MAX=1
PRESENTATION_AUTO_IMAGE_SIZE=1024
# One web search per deck so slide figures come from sources rather than the
# model's recollection. Needs a configured search provider; without one a deck
# is planned ungrounded and told not to assert figures it cannot support.
PRESENTATION_RESEARCH_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0
MODEL_GATE_ENABLED=false
MODEL_GATE_LEASE_SECONDS=300
MODEL_GATE_POLL_SECONDS=0.1
IMAGE_MAX_UPLOAD_BYTES=10485760
IMAGE_MAX_OUTPUT_BYTES=41943040
IMAGE_MAX_PIXELS=20000000
VISION_INFERENCE_ADAPTER=
VISION_LLM_BASE_URL=http://127.0.0.1:8003
VISION_MODEL=qwen/qwen3.5-4b
VISION_LLM_REASONING_EFFORT=none
# One upload inspection now returns observation, answer, grounding, a
# search query and any identifications under a strict schema. Two real
# photographs measured 488 completion tokens, so 512 truncated the JSON
# and answered a valid upload with a 502.
VISION_MAX_TOKENS=1536
# Optional one-shot specialist retry for primary-VLM model uncertainty only.
VISION_ESCALATION_LLM_BASE_URL=
VISION_ESCALATION_MODEL=
VISION_ESCALATION_LLM_REASONING_EFFORT=none
# Prior question/answer pairs replayed to the VLM for image followup questions.
VISION_THREAD_CONTEXT_TURNS=8
# Total question/answer pairs retained in one image's stored analysis thread.
VISION_THREAD_MAX_STORED=40

# Host path to your existing ComfyUI install (mounted into the comfyui container).
# On a DGX Spark this is a Linux path, e.g. /home/you/ComfyUI.
COMFYUI_HOST_PATH=/home/you/ComfyUI
# Which ComfyUI image to build: Dockerfile (RTX-50-series, sm_120, x86) or
# Dockerfile.gb10 (DGX Spark, sm_121, aarch64, CUDA 13). Set the GB10 one on a
# Spark. Where ComfyUI runs is then an .env decision, not a compose edit:
# COMFYUI_DOCKERFILE=Dockerfile.gb10
COMFYUI_DOCKERFILE=Dockerfile

# Pinned vLLM model cache shared by the generation and embedding containers.
VLLM_MODEL_CACHE_PATH=/home/you/hf-cache
VLLM_COMPILE_CACHE_PATH=/home/you/vllm-compile-cache
# Qualified single-RTX-5080 latency profile. Compose also enables V1 chunked
# prefill, async scheduling, and prefix caching explicitly. Change one value at
# a time and repeat the provider benchmark plus owning browser/API paths.
# FP8 needs Ada or newer (the RTX 5080 reports compute capability 12.0). Set
# both dtypes back to `auto` on a GPU without native FP8 tensor cores.
VLLM_MAIN_QUANTIZATION=fp8
# `auto`, not fp8. An FP8 KV cache holds more tokens per GiB, and it is also the
# one setting docker-compose.yml records as breaking wake-from-sleep on vLLM
# 0.23.0 (`'list' object has no attribute 'zero_'`), stranding the engine
# asleep. Compose already defaults to `auto` for that reason; shipping fp8 here
# quietly overrode it for anyone who copied this file. FP8 *weights* above are
# unaffected and stay.
VLLM_MAIN_KV_CACHE_DTYPE=auto
VLLM_MAIN_MAX_MODEL_LEN=16384
VLLM_MAIN_MAX_NUM_SEQS=4
VLLM_MAIN_MAX_BATCHED_TOKENS=4096
VLLM_MAIN_GPU_MEMORY_UTILIZATION=0.55
VLLM_EMBEDDING_MAX_MODEL_LEN=2048
VLLM_EMBEDDING_MAX_NUM_SEQS=16
VLLM_EMBEDDING_GPU_MEMORY_UTILIZATION=0.06

# Hybrid web research. Google Search Grounding is primary when a Google key is
# present; Tavily is the fallback. Leaving both keys empty disables search.
# Google availability depends on the API project's current quota and billing state.
# AniOS keeps a separate 450-request/day local safety ceiling.
# Tavily free tier: 1,000 basic searches/month. Never enable paid overages.
SEARCH_PROVIDER_NAME=mcp
SEARCH_BASE_URL=https://api.tavily.com
SEARCH_API_KEY=
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT_SECONDS=15
SEARCH_MAX_CONTENT_CHARS=2000
SEARCH_DEPTH=basic
SEARCH_MCP_SERVER_ID=internet
SEARCH_MCP_TOOL_NAME=search_web
GOOGLE_API_KEY=
# GEMINI_API_KEY is accepted as an alternative when GOOGLE_API_KEY is empty.
GEMINI_API_KEY=
GOOGLE_SEARCH_ENABLED=false
GOOGLE_SEARCH_MODEL=gemini-3.6-flash
GOOGLE_SEARCH_TIMEOUT_SECONDS=30
GOOGLE_SEARCH_MAX_OUTPUT_TOKENS=2048
GOOGLE_SEARCH_DAILY_LIMIT=450
GOOGLE_SEARCH_QUOTA_DB_PATH=data/search/google_search_quota.sqlite3

# MCP servers to discover tools from. Pin exact versions: "npx -y pkg" resolves
# to whatever is published at that moment, which is the rug-pull vector.
# Example: [{"server_id":"drive","command":"npx.cmd","args":["-y","@modelcontextprotocol/server-gdrive@1.0.0"],"risk_classification":"untrusted"}]
MCP_SERVERS_JSON=[{"server_id":"local_utility","command":"python","args":["-m","backend.mcp.servers.local_utility"],"risk_classification":"read_only"},{"server_id":"internet","command":"python","args":["-m","backend.mcp.servers.internet"],"inherit_env":["SEARCH_API_KEY","SEARCH_BASE_URL","SEARCH_MAX_RESULTS","SEARCH_TIMEOUT_SECONDS","SEARCH_MAX_CONTENT_CHARS","SEARCH_MIN_SCORE","SEARCH_DEPTH","GOOGLE_API_KEY","GEMINI_API_KEY","GOOGLE_SEARCH_ENABLED","GOOGLE_SEARCH_MODEL","GOOGLE_SEARCH_TIMEOUT_SECONDS","GOOGLE_SEARCH_MAX_OUTPUT_TOKENS","GOOGLE_SEARCH_DAILY_LIMIT","GOOGLE_SEARCH_QUOTA_DB_PATH"],"risk_classification":"read_only"},{"server_id":"local_visual","transport":"http","url":"http://local-capabilities:8001/mcp","forward_context":true,"risk_classification":"untrusted"}]
MCP_LIST_TIMEOUT_SECONDS=30
TOOL_SEARCH_MAX_COSINE_DISTANCE=0.45
TOOL_SEARCH_MAX_RESULTS=5

# HTTP-transport MCP server example (sibling container or remote vendor):
# MCP_SERVERS_JSON=[{"server_id":"drive","transport":"http","url":"http://mcp-gdrive:8080/mcp","headers":{"authorization":"Bearer ..."},"risk_classification":"untrusted"}]
# Built-in read-only internet MCP server (set SEARCH_PROVIDER_NAME=mcp):
# MCP_SERVERS_JSON=[{"server_id":"internet","command":"python","args":["-m","backend.mcp.servers.internet"],"inherit_env":["SEARCH_API_KEY","SEARCH_BASE_URL","SEARCH_MAX_RESULTS","SEARCH_TIMEOUT_SECONDS","SEARCH_MAX_CONTENT_CHARS","SEARCH_MIN_SCORE","SEARCH_DEPTH","GOOGLE_API_KEY","GEMINI_API_KEY","GOOGLE_SEARCH_ENABLED","GOOGLE_SEARCH_MODEL","GOOGLE_SEARCH_TIMEOUT_SECONDS","GOOGLE_SEARCH_MAX_OUTPUT_TOKENS","GOOGLE_SEARCH_DAILY_LIMIT","GOOGLE_SEARCH_QUOTA_DB_PATH"],"risk_classification":"read_only"}]
# Local utility plus internet example for configured-model tool selection and MCP search:
# MCP_SERVERS_JSON=[{"server_id":"local_utility","command":"python","args":["-m","backend.mcp.servers.local_utility"],"risk_classification":"read_only"},{"server_id":"internet","command":"python","args":["-m","backend.mcp.servers.internet"],"inherit_env":["SEARCH_API_KEY","SEARCH_BASE_URL","SEARCH_MAX_RESULTS","SEARCH_TIMEOUT_SECONDS","SEARCH_MAX_CONTENT_CHARS","SEARCH_MIN_SCORE","SEARCH_DEPTH","GOOGLE_API_KEY","GEMINI_API_KEY","GOOGLE_SEARCH_ENABLED","GOOGLE_SEARCH_MODEL","GOOGLE_SEARCH_TIMEOUT_SECONDS","GOOGLE_SEARCH_MAX_OUTPUT_TOKENS","GOOGLE_SEARCH_DAILY_LIMIT","GOOGLE_SEARCH_QUOTA_DB_PATH"],"risk_classification":"read_only"}]
# Existing visual services as agent-facing FastMCP tools (Compose hostname):
# MCP_SERVERS_JSON=[{"server_id":"local_visual","transport":"http","url":"http://local-capabilities:8001/mcp","forward_context":true,"risk_classification":"untrusted"}]

# OpenTelemetry tracing (off by default). Set OTEL_ENABLED=true and either
# OTEL_EXPORTER=console for local spans, or OTEL_EXPORTER=otlp with an
# endpoint such as http://jaeger:4318/v1/traces to ship to a collector.
OTEL_ENABLED=false
OTEL_EXPORTER=console
OTEL_EXPORTER_OTLP_ENDPOINT=

# Reverse geocoding for the Agents tab "use my location" button. Empty disables
# it, and typing a town works without it. The coordinate is rounded to roughly a
# kilometre before the single lookup, and only the resulting town is stored.
DISCOVERY_PLACE_RESOLVER=

# How long being somewhere other than home lasts before Scout looks around home
# again. Reporting a location is what starts it; there is no mode to switch off,
# so this is what stops a forgotten trip redirecting every future digest.
DISCOVERY_TRIP_DAYS=14

# Calendar links in a digest must open on the phone they were sent to. localhost
# is the phone from the phone, and a container address is unreachable from it, so
# this has to be an address other devices can actually reach. With the named
# tunnel below this is the public hostname and never changes; with a quick
# tunnel, `scripts/start-tunnel.sh` rewrites it on every start.
DISCOVERY_CALENDAR_BASE_URL=https://deep-matter.com/api/v1/discovery

# --- Public hostname -------------------------------------------------------
#
# Set both to serve on a stable address through a named Cloudflare tunnel. Left
# empty, `scripts/start-tunnel.sh` falls back to a quick tunnel with a random
# hostname that dies with the machine.
#
# The one-time setup — creating the tunnel and pointing DNS at it — is in
# docs/DEVELOPMENT_GUIDE.md. It needs a browser login to the Cloudflare account
# that holds the domain, so it is done by hand, once, on the machine that serves.
ANIOS_TUNNEL_NAME=anios
ANIOS_PUBLIC_HOSTNAME=deep-matter.com

# --- Off-machine backup copies ---------------------------------------------
#
# scripts/backup-db.sh dumps the database and pushes a copy to each host here.
# BACKUP_MIRROR_HOST is a whitespace-separated LIST (SSH targets, key-based
# auth), so a third copy joins the others rather than replacing them - e.g.
# "spark2 mac". One shared path applies to every target; keep it off any
# iCloud-synced directory on a Mac. Unset, the backup stays on one disk.
#   BACKUP_MIRROR_HOST=animallya96@172.16.8.5 animallya96@<mac-lan-ip>
#   BACKUP_MIRROR_PATH=~/anios-backups
# The Mac copy must hold ciphertext only: never copy ENCRYPTION_KEY onto it.
BACKUP_MIRROR_HOST=
BACKUP_MIRROR_PATH=~/anios-backups

# --- Operator alerts -------------------------------------------------------
#
# scripts/notify-operator.sh (wired into systemd OnFailure units) pages the
# operator over the iMessage bridge when a job fails. Host-level and curl-only,
# so it works even when the app is down. Unset, alerting is a no-op. The URL and
# token are the same bridge the app uses; the phone must be allowlisted on the
# Mac. Keep them here rather than parsing MCP_SERVERS_JSON in shell.
#   ALERT_BRIDGE_URL=http://<mac-lan-ip>:8010/mcp
#   ALERT_BRIDGE_TOKEN=<the x-anios-bridge-token secret>
#   OPERATOR_ALERT_PHONE=+1XXXXXXXXXX
ALERT_BRIDGE_URL=
ALERT_BRIDGE_TOKEN=
OPERATOR_ALERT_PHONE=
