[Unit]
# The main LLM's rank-0 process, which also serves the OpenAI API on :8000.
#
# Without this the Sparks come back from a power cycle with Docker up, the
# whole application stack restarted by its restart policy - and no model
# behind it, because ~/ds4-tp2.sh was only ever run by hand.
Description=AniOS main LLM (DeepSeek V4 Flash, TP=2 head)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
User=animallya96
# The launch script runs docker in the foreground with --rm, so systemd
# supervises the container's lifetime directly.
ExecStart=/home/animallya96/ds4-tp2.sh head
ExecStop=/usr/bin/docker stop -t 60 ds4-head
Restart=always
RestartSec=30
# The head blocks until rank 1 joins. spark2 may still be booting, and vLLM's
# own VLLM_ENGINE_READY_TIMEOUT_S is 3600, so let systemd wait at least that
# long rather than killing a startup that is progressing normally.
TimeoutStartSec=3900
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
