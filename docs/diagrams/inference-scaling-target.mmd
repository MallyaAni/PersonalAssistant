flowchart LR
    Requests[Chat, vision,<br/>tools and durable jobs]

    subgraph Application[Application-owned control]
        Roles[Registered model roles]
        Adapters[Provider-neutral<br/>inference adapters]
        Placement[Capacity and placement policy]
        State[(Durable jobs<br/>and leases)]
        Workers[Agent worker replicas]
        State --> Workers --> Roles
        Roles --> Adapters --> Placement
    end

    subgraph Serving[Replaceable serving pools]
        Gateway[Stable inference endpoints]
        Generation[[Generation and vision<br/>vLLM replicas]]
        Embeddings[[Embedding<br/>vLLM replicas]]
        Specialists[[Future specialist<br/>model pools]]
        Gateway --> Generation
        Gateway --> Embeddings
        Gateway -.-> Specialists
    end

    subgraph Platform[Deployment and operations]
        ControlPlane[Ray Serve or Kubernetes<br/>autoscaling and back-pressure]
        Metrics[(Prometheus metrics<br/>and model SLOs)]
        Models[(Pinned model artifacts)]
    end

    Requests --> Roles
    Placement --> Gateway
    ControlPlane -.-> Gateway
    ControlPlane -.-> Workers
    Generation --> Metrics
    Embeddings --> Metrics
    Specialists -.-> Metrics
    Models --> Generation
    Models --> Embeddings
    Models -.-> Specialists

