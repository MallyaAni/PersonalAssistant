    class User,MainCaller,UI,API,AgentEvents interface;
    class MCP,Gates,JobService,Worker,Claim,Draft,Service,Agent,GraphNode,Provider,Compiler,ImageCoordinator,ImageService,Renderer,PptxGenJS,OOXML,Repository,Chat application;
    class JobStore,Database,BinaryStore data;
    class Gate,LMStudio,ComfyUI,LibreOffice external;
    class NoAuthority warning;
