    classDef data fill:#eef7ee,stroke:#5f9562,color:#183b1b;
    classDef target fill:#fff3cd,stroke:#b78b20,color:#4d3900,stroke-dasharray:5 4;
    classDef external fill:#f1edff,stroke:#8872c6,color:#2e2450;
    class User,Create,Recall,Change,UI,Clarify interface;
    class Generate,Ready,PixelEmbed,EditRead,Instruction,Editor,DeterministicCheck,Promote implemented;
    class Binary,PixelIndex data;
    class HiDream external;
    class ObserveJob,OwnedRead,VLM,Semantics,ObservationStore,SemanticIndex,ReferenceStore,Resolver,Match,Handle,Gate,Candidate,Verify,Accept,Retry,Fail,VisualAgent,Policy,Resource,MCP,Delete target;
