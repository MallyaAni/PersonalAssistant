---
title: AniOS System Overview
---
flowchart TB
    User([User])

    subgraph Experience[User experience]
        Frontend[React frontend]
        API[FastAPI API]
        Frontend --> API
    end

    subgraph Orchestration[Application-owned orchestration]
        Identity[Invited registration,<br/>session and ownership gate]
        Supervisor{Main supervisor}
        Conversation[Assistant and DiagramAgent]
        Presentation[PresentationAgent<br/>and durable worker]
        Memory[Memory coordinator]
        Discovery[Scout ambient discovery]
        Visual[Image and vision services]
        Tools[MCP and search gates]
    end

    subgraph LocalAI[Replaceable local AI and rendering]
        ModelGate[Redis model-priority gate]
        Inference[Provider-neutral<br/>inference adapters]
        VLLM[vLLM services<br/>Qwen 3.5 4B: generation and vision<br/>Nomic: text embeddings]
        Media[ComfyUI: HiDream and FLUX<br/>PptxGenJS and LibreOffice]
        VisionEmbed[Nomic vision embedding<br/>ONNX on CPU]
    end

    subgraph Storage[Private local storage]
        Repositories[Owned persistence services]
        Database[(PostgreSQL<br/>and pgvector)]
        Files[(Opaque artifact files)]
        Repositories --> Database
        Repositories --> Files
    end

    subgraph External[Optional external capabilities]
        Integrations[[Configured MCP servers<br/>Google Search or Tavily]]
    end

    User --> Frontend
    API --> Identity --> Supervisor
    Supervisor -->|chat or diagram| Conversation
    Supervisor -->|presentation| Presentation
    Identity --> Visual
    Identity --> Discovery
    Conversation <--> Memory
    Discovery <--> Memory

    Conversation --> Tools --> Integrations
    Discovery --> Tools

    Conversation --> ModelGate
    Presentation --> ModelGate
    ModelGate --> Inference
    Visual --> Inference
    Memory --> Inference
    Discovery --> Inference
    Inference --> VLLM
    Visual --> Media
    Visual --> VisionEmbed
    Presentation --> Media

    Conversation --> Repositories
    Presentation --> Repositories
    Visual --> Repositories
    Memory --> Repositories
    Discovery --> Repositories

