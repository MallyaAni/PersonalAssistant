flowchart LR
    User([Primary user])
    Maintainer([Maintainer])

    subgraph Interface[Local interface]
        Frontend[React and Vite frontend<br/>chat, image create/analyze, presentations,<br/>private history and export; localhost:5173]
        API[FastAPI v1 API<br/>localhost:8000]
    end

    subgraph Application[Application and orchestration]
        Conversation[ConversationService]
        DiagramArtifacts[DiagramArtifactService<br/>bounded Mermaid lifecycle]
        ImageArtifacts[ImageArtifactService<br/>generation, upload, integrity, deletion]
        Vision[VisionAnalysisService<br/>grounded image understanding]
        DiagramAgent[DiagramAgent<br/>specialized LangGraph workflow]
        PresentationService[PresentationService<br/>revision and promotion authority]
        PresentationJobs[PresentationJobService<br/>durable queue and reconnect]
        PresentationWorker[Presentation worker<br/>leased LangGraph execution]
        PresentationImage[PresentationImageService<br/>optional selected-slide image microtask]
        PresentationAgent[PresentationAgent<br/>focused LangGraph workflow]
        PresentationCompiler[Deterministic presentation compiler<br/>outline and slide microtasks to editable DeckSpec]
        Candidate[Architecture candidate service<br/>review-only repository context]
        Supervisor[MainSupervisorAgent<br/>deterministic LangGraph router<br/>NO LLM CALL<br/>registered intents only]
        Coordinator[MemoryCoordinatorAgent<br/>deterministic policy]
        Graph[Assistant LangGraph<br/>one main-model streaming node]
        Memory[Typed personal and agent memory services]
        Toolbox[Safe tool-memory service<br/>semantic descriptor shortlist]
        ToolOrchestration[MCP tool orchestration<br/>main-model native selection,<br/>app-owned execution]
        LLMQueue[Redis model priority gate<br/>foreground chat before<br/>background slide microtasks]
        MCPInvocation[MCP invocation gates<br/>live contract, policy, privacy]
        VisualMCP[Local capability FastMCP facade<br/>visual and presentation handles]
        Research[Hybrid research policy<br/>Google primary, Tavily fallback,<br/>explicit dual-provider verification]
    end

    subgraph Infrastructure[Local infrastructure]
        Database[(PostgreSQL and pgvector<br/>conversations, memory, visual artifacts,<br/>presentation revisions and durable jobs)]
        LMStudio[LM Studio model host<br/>MAIN and DIAGRAM: qwen/qwen3.5-9b<br/>PRESENTATION and VISION:<br/>google/gemma-4-12b<br/>EMBEDDING_MODEL:<br/>text-embedding-nomic-embed-text-v1.5]
        ComfyUI[ComfyUI local raster generation<br/>IMAGE_MODEL:<br/>hidream_o1_image_dev_fp8_scaled.safetensors]
        BinaryStore[(Opaque local binary artifact store)]
        Redis[(Redis<br/>expiring model lease and<br/>foreground waiter count only)]
        VisionEmbed[VISION_EMBEDDING_MODEL:<br/>nomic-embed-vision-v1.5<br/>in-process ONNX, aligned image vectors]
        Diagrams[(Canonical Mermaid suite<br/>plus review candidates)]
        SearchQuota[(Daily Google call counter<br/>provider, Pacific date, count only)]
        PresentationRenderer[PptxGenJS renderer<br/>native Office objects plus LibreOffice validation]
    end

    User --> Frontend
    Maintainer --> Candidate
    Frontend -->|Intent-routed JSON, multipart, private image bytes,<br/>chat SSE, memory drilldown, and restore| API
    API --> Conversation
    API --> Memory
    API --> Toolbox
    API --> PresentationJobs
    API --> PresentationService
    API --> PresentationImage
    Conversation -->|first routing boundary| Supervisor
    Supervisor -->|ordinary assistant path| Coordinator
    Coordinator --> Graph
    Supervisor -->|typed delegation:<br/>presentation_agent| PresentationJobs
    Conversation --> ToolOrchestration
    Conversation -->|explicit diagram lifecycle| DiagramArtifacts
    DiagramArtifacts --> DiagramAgent
    API -->|POST images/generate| ImageArtifacts
    API -->|bounded multipart upload| Vision
    Vision --> ImageArtifacts
    Vision -->|model call: VISION_MODEL| LMStudio
    ImageArtifacts -->|model call: IMAGE_MODEL| ComfyUI
    ImageArtifacts --> BinaryStore
    ImageArtifacts -->|bounded prompt provenance<br/>for referenced-image context| Conversation
    Candidate --> DiagramAgent
    Candidate -->|read canonical and explicit source context| Diagrams
    Candidate -->|new candidate only; manual review required| Diagrams
    Conversation --> Database
    Coordinator --> Memory
    Coordinator --> Toolbox
    ToolOrchestration --> Toolbox
    ToolOrchestration -->|conditional model call:<br/>MAIN_LLM_MODEL native tool selection| LLMQueue
    ToolOrchestration --> MCPInvocation
    Conversation -->|freshness and privacy policy| InternetMCP
    InternetMCP --> MCPInvocation
    MCPInvocation --> MCPServers
    MCPInvocation -->|streamable HTTP plus hidden<br/>user, conversation, and trace context| VisualMCP
    VisualMCP --> DiagramArtifacts
    VisualMCP --> ImageArtifacts
    VisualMCP --> Vision
    VisualMCP --> PresentationJobs
    VisualMCP --> PresentationService
    InternetMCP -->|read-only search_web| Research
    Research -->|conditional model call:<br/>GOOGLE_SEARCH_MODEL;<br/>minimized query only| GoogleResearch
    GoogleResearch -->|native grounding tool| GoogleSearch
    Research -->|fallback or explicit cross-check| WebSearch
    Research --> SearchQuota
    Graph -->|model call: MAIN_LLM_MODEL<br/>chat completion| LLMQueue
    DiagramAgent -->|model call: DIAGRAM_LLM_MODEL<br/>bounded diagram specification| LLMQueue
    PresentationJobs -->|enqueue and reconnect| Database
    PresentationWorker -->|claim, heartbeat, drafts,<br/>and terminal state| Database
    PresentationWorker --> PresentationService
    PresentationService --> PresentationAgent
    PresentationImage -->|owned generation request| ImageArtifacts
    PresentationImage -->|attach image UUID in linked revision| PresentationService
    PresentationAgent -->|model call: PRESENTATION_LLM_MODEL<br/>outline, one slide, or slide edit| LLMQueue
    PresentationAgent -->|validated creation plan| PresentationCompiler
    PresentationCompiler -->|strict editable DeckSpec| PresentationService
    PresentationAgent -->|validated SlideEdit applied to selected slide| PresentationService
    PresentationService -->|validated specification<br/>plus owned image bytes when referenced| PresentationRenderer
    PresentationRenderer -->|editable pptx bytes| BinaryStore
    PresentationService -->|promote only after validation| Database
    LLMQueue --> LMStudio
    LLMQueue -->|coordination only| Redis
    DiagramArtifacts --> Database
    ImageArtifacts --> Database
    Memory --> Database
    Memory -->|model call: EMBEDDING_MODEL| LMStudio
    ImageArtifacts -->|image bytes at store time| VisionEmbed
    VisionEmbed -->|aligned 768-dim vectors| Database
    Toolbox --> Database
    Toolbox -->|model call: EMBEDDING_MODEL<br/>safe descriptor text| LMStudio

