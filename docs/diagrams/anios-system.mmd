    classDef scaffold fill:#fff3cd,stroke:#b78b20,color:#4d3900,stroke-width:1.5px,stroke-dasharray:5 4;
    class Frontend,API interface;
    class User,Maintainer interface;
    class Conversation,DiagramArtifacts,ImageArtifacts,Vision,DiagramAgent,PresentationService,PresentationJobs,PresentationWorker,PresentationImage,PresentationAgent,PresentationCompiler,Candidate,Supervisor,Coordinator,Graph,Memory,Toolbox,ToolOrchestration,LLMQueue,MCPInvocation,VisualMCP,Research application;
    InternetMCP[[Built-in internet MCP server<br/>stdio, read-only]]
    MCPServers[[Configured MCP servers<br/>stdio or streamable HTTP]]
    GoogleResearch[[GOOGLE_SEARCH_MODEL:<br/>gemini-3.6-flash research worker<br/>external and disabled by default]]
    GoogleSearch[[Google Search Grounding<br/>external public web]]
    WebSearch[[Tavily web search<br/>external fallback, opt-in, untrusted]]
    class Database,Redis,LMStudio,ComfyUI,BinaryStore,Diagrams,VisionEmbed,SearchQuota,PresentationRenderer infrastructure;
