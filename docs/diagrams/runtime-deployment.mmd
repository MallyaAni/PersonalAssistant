---
title: Runtime Deployment
---
flowchart TB
    User([User]) --> Browser[Browser]
    User --> Phone[Messages on a phone]

    subgraph Spark1[spark1 - Docker Compose plus one systemd unit]
        Gateway[Same-origin gateway :8080<br/>compiled React and API proxy]
        Frontend[Vite development server<br/>:5173]
        Backend[FastAPI backend<br/>chat, SSE, tools, recall]
        Discovery[Discovery worker<br/>Scout sweeps, scheduled tasks,<br/>iMessage polling]
        Worker[Presentation worker]
        Maintenance[Memory maintenance and<br/>storage collection timers]
        MCP[Local capability MCP<br/>:8001]
        Renderer[PPTX renderer<br/>:8002]
        Adapters[In-process provider-neutral<br/>inference adapters]
        VLLMMain[vLLM :8000 DeepSeek V4 Flash<br/>tensor-parallel rank 0, systemd<br/>every text role]
        VLLMEmbed[vLLM embedding :8004<br/>Nomic text embeddings]
        VLLMRerank[vLLM reranker :8006<br/>Qwen3-Reranker-0.6B]
        Stores[(PostgreSQL and pgvector<br/>Redis, append-only<br/>both on host loopback only)]
        Tunnel[Cloudflare tunnel<br/>deep-matter.com, no LAN port opened]
    end

    subgraph Spark2[spark2 - systemd units]
        VLLMRank1[vLLM DeepSeek V4 Flash<br/>tensor-parallel rank 1]
        VLM[vLLM :8001 Qwen3-VL-8B<br/>vision]
        Mirror1[(Backup mirror)]
    end

    subgraph Mac[MacBook]
        Bridge[iMessage bridge MCP<br/>allowlist, send, read, attachments]
        Mirror2[(Backup mirror<br/>ciphertext only)]
    end

    subgraph Desktop[Windows desktop, RTX 5080 - sometimes off]
        ComfyUI[ComfyUI :8188<br/>FLUX.2 Klein generation<br/>FLUX.1 Kontext editing]
    end

    subgraph External[Optional external services]
        Integrations[[Configured MCP servers<br/>Google Search and Tavily]]
    end

    Browser -->|public HTTPS| Tunnel --> Gateway
    Browser -.->|local development| Frontend
    Phone <-->|iMessage| Bridge
    Gateway --> Backend
    Frontend --> Backend
    Backend --> Stores
    Backend --> Adapters
    Backend -->|only while the desktop is on| ComfyUI
    Backend --> MCP
    Backend --> Integrations
    Backend -->|send, read| Bridge
    Discovery -->|poll, deliver| Bridge
    Discovery --> Stores
    Discovery --> Adapters

    Stores -->|durable jobs| Worker
    Worker --> Stores
    Worker --> Adapters
    Worker --> ComfyUI
    Worker --> Renderer
    Renderer --> Stores
    Maintenance --> Stores
    MCP --> Stores
    MCP --> Adapters
    Adapters --> VLLMMain
    Adapters --> VLLMEmbed
    Adapters --> VLLMRerank
    Adapters --> VLM
    VLLMMain <-->|RoCE fabric| VLLMRank1
    Stores -.->|nightly dump| Mirror1
    Stores -.->|nightly dump| Mirror2

