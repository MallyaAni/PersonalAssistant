flowchart TB
    User([User]) --> Browser[Browser]

    subgraph Compose[Docker Compose]
        Gateway[Same-origin gateway :8080<br/>compiled React and API proxy]
        Frontend[Vite development server<br/>:5173]
        Backend[FastAPI<br/>:8000]
        Worker[Presentation worker]
        MCP[Local capability MCP<br/>:8001]
        Renderer[PPTX renderer<br/>:8002]
        Adapters[In-process provider-neutral<br/>inference adapters]
        VLLMMain[vLLM :8000 DeepSeek V4 Flash FP8, TP=2<br/>vLLM :8001 Qwen3-VL-8B AWQ on spark2<br/>generation and vision are separate models now]
        VLLMEmbed[vLLM embedding :8004<br/>Nomic text embeddings]
        Stores[(PostgreSQL and pgvector<br/>accounts and sessions<br/>Redis lease and artifact volume)]
        VLLMMain -.->|healthy before start| VLLMEmbed
    end

    subgraph Host[Host media process]
        ComfyUI[ComfyUI :8188<br/>FLUX.2 Klein generation and editing]
    end

    subgraph External[Optional external services]
        Integrations[[Configured MCP servers<br/>Google Search and Tavily]]
        PublicEdge[[Planned HTTPS tunnel<br/>public users install nothing]]
    end

    PublicEdge -.->|not configured| Gateway
    Browser -->|production login and HttpOnly cookie| Gateway
    Browser -.->|local development| Frontend
    Gateway --> Backend
    Frontend --> Backend
    Backend --> Stores
    Backend --> Adapters
    Backend --> ComfyUI
    Backend --> MCP
    Backend --> Integrations

    Stores -->|durable jobs| Worker
    Worker --> Stores
    Worker --> Adapters
    Worker --> ComfyUI
    Worker --> Renderer
    Renderer --> Stores
    MCP --> Stores
    MCP --> Adapters
    Adapters --> VLLMMain
    Adapters --> VLLMEmbed

