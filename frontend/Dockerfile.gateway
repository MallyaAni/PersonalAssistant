# Build the public AniOS browser bundle without embedding a host-specific API URL.
FROM node:22-alpine AS build

WORKDIR /app

ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

COPY package.json package-lock.json ./
RUN npm install --no-audit --no-fund

COPY . .
RUN npm run build

# Serve one static origin and proxy only /api to the private backend network.
FROM nginxinc/nginx-unprivileged:1.27-alpine

COPY nginx.gateway.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080

